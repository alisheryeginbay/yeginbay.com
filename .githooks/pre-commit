#!/bin/sh
# Re-subsets the Korean fonts when a commit adds Hangul, so a new syllable
# never ships without its glyph. Enable with: git config core.hooksPath .githooks
added_hangul() {
  git diff --cached -U0 -- content data layouts hugo.toml | perl -CSD -ne '
    $found = 1 if /^\+.*[\x{1100}-\x{11FF}\x{3130}-\x{318F}\x{A960}-\x{A97F}\x{AC00}-\x{D7FF}]/;
    END { exit($found ? 0 : 1) }'
}

if added_hangul; then
  bun run --silent subset-korean >/dev/null || {
    echo "pre-commit: subset-korean failed; fix it or commit with --no-verify" >&2
    exit 1
  }
  git add static/fonts/sourcehanserifkr-*.woff2
fi
