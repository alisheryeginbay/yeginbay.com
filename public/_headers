# Fingerprinted by Astro, so a changed file always gets a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not fingerprinted, but never edited in place: rename the file to change it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=86400
/images/*
  Cache-Control: public, max-age=86400

# Post sources, shown in the browser instead of downloaded.
/*.mdx
  Content-Type: text/plain; charset=utf-8
/*.typ
  Content-Type: text/plain; charset=utf-8
/LICENSE
  Content-Type: text/plain; charset=utf-8
