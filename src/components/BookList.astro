---
// A list of books from the front matter of content/pages/books.mdx.
import type { Book } from "../content.config.ts";

interface Props {
  books: Book[];
}

const { books } = Astro.props;
---

<ul class="book-list">
  {
    books.map((book) => (
      <li>
        <span class="book-title">{book.title}</span> <span class="book-author">{book.author}</span>
        {book.favourite && (
          <span class="book-favourite" title="Favourite">
            ♥
          </span>
        )}
        {book.rating && (
          <span class="book-rating" title={`${book.rating} out of 10`}>
            {book.rating}/10
          </span>
        )}
      </li>
    ))
  }
</ul>
