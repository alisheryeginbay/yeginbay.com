---
// Every post, at /<name> for content/posts/ and /<section>/<name> for other
// sections, and a redirect to it from each of its `aliases`.
import LinkList from "../components/LinkList.astro";
import Sources from "../components/Sources.astro";
import Toc from "../components/Toc.astro";
import SetWords from "../components/viz/Set.astro";
import Show from "../components/viz/Show.astro";
import Var from "../components/viz/Var.astro";
import Viz from "../components/viz/Viz.astro";
import Base from "../layouts/Base.astro";
import { isoDate, isoDateTime, longDate } from "../lib/dates.ts";
import { allPosts, hasDropCap, renderPost, type Post } from "../lib/posts.ts";
import { isExternal } from "../lib/markdown/rehype-links.ts";
import { AUTHOR_LINKS, SITE } from "../site.ts";
import type { Work } from "../content.config.ts";

export async function getStaticPaths() {
  const posts = await allPosts();
  return [
    ...posts.map((post) => ({ params: { slug: post.url.slice(1) }, props: { post } })),
    ...posts.flatMap((post) =>
      post.aliases.map((alias) => ({ params: { slug: alias.replace(/^\/|\/$/g, "") }, props: { redirect: post.url } })),
    ),
  ];
}

type Props = { post: Post; redirect?: undefined } | { post?: undefined; redirect: string };

const { post, redirect } = Astro.props;
const target = redirect && new URL(redirect, SITE.url).href;

const rendered = post && (await renderPost(post));
// References and Further reading follow the text, and the table of contents.
const sources = post && { references: post.entry.data.references, further: post.entry.data.further };
const headings = rendered ? [...rendered.headings] : [];
if (post && sources) {
  const depth = Math.min(2, ...headings.map((h) => h.depth));
  const add = (slug: string, text: string) => {
    if (headings.some((h) => h.slug === slug)) throw new Error(`${post.source}: a heading's id is "${slug}", which ${text} uses`);
    headings.push({ depth, slug, text });
  };
  if (sources.references.length) add("references", "References");
  if (sources.further.length) add("further-reading", "Further reading");
}
// Components posts use without importing them.
const components = { LinkList, Set: SetWords, Show, Var, Viz };
const external = (href: string) => (isExternal(href) ? { target: "_blank", rel: "noopener noreferrer" } : {});
// A post by the site's author alone needs no byline.
const byline = post && post.authors.join(",") !== SITE.author ? post.authors : [];
const started = post && isoDate(post.date);
const updated = post && isoDate(post.lastmod);
const history = post && `${SITE.repo}/commits/main/${post.source}`;
// Posts without a description of their own are described by their opening.
const description = post && rendered && (post.description ?? (rendered.summary || undefined));
const source = post && {
  href: post.sourceUrl,
  type: post.sourceUrl.endsWith(".mdx") ? "text/markdown" : "text/plain",
};
// The post as schema.org describes it, for search engines and models.
const abs = (path: string) => new URL(path, SITE.url).href;
const jsonLd = post && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description,
  url: abs(post.url),
  mainEntityOfPage: abs(post.url),
  datePublished: isoDateTime(post.date),
  dateModified: isoDateTime(post.lastmod),
  inLanguage: "en",
  keywords: post.tags.length ? post.tags.join(", ") : undefined,
  author: post.authors.map((name) =>
    name === SITE.author ? { "@type": "Person", name, url: SITE.url } : { name, url: AUTHOR_LINKS[name] && abs(AUTHOR_LINKS[name]) },
  ),
  publisher: { "@type": "Person", name: SITE.author, url: SITE.url },
  license: abs("/LICENSE"),
  isPartOf: { "@type": "WebSite", name: SITE.title, url: SITE.url },
  encoding: { "@type": "MediaObject", contentUrl: abs(post.sourceUrl), encodingFormat: source!.type },
  citation: post.entry.data.references.length
    ? post.entry.data.references.map((w: Work) => ({
        "@type": "CreativeWork",
        name: w.title,
        author: w.author,
        datePublished: w.year?.toString(),
        url: w.url,
      }))
    : undefined,
};
---

{
  target ? (
    <html lang="en">
      <head>
        <title>{target}</title>
        <link rel="canonical" href={target} />
        <meta charset="utf-8" />
        <meta http-equiv="refresh" content={`0; url=${target}`} />
      </head>
    </html>
  ) : (
    post &&
    rendered && (
      <Base
        title={post.title}
        description={description}
        ogType="article"
        source={source}
        jsonLd={jsonLd}
        authors={post.authors}
        noindex={post.noindex}
        dropCap={hasDropCap(post, rendered)}
        hasMath={rendered.hasMath}
        typstCss={rendered.typstCss}
      >
        {headings.length >= 2 && <Toc slot="sidebar" headings={headings} />}
        <article class="post">
          <h1>{post.title}</h1>
          <p class="post-meta">
            {post.status !== "finished" && (
              <>
                <span class="post-status">{post.status}</span> ·{" "}
              </>
            )}
            {byline.length > 0 && (
              <>
                By{" "}
                <span class="post-author">
                  {byline.map((name, i) => (
                    <>
                      {i > 0 && ", "}
                      {AUTHOR_LINKS[name] ? (
                        <a href={AUTHOR_LINKS[name]} {...external(AUTHOR_LINKS[name])}>
                          {name}
                        </a>
                      ) : (
                        name
                      )}
                    </>
                  ))}
                </span>{" "}
                ·{" "}
              </>
            )}
            {post.status !== "finished" && "Started "}
            <time datetime={started}>{longDate(post.date)}</time>
            {post.tags.map((tag) => (
              <>
                {" "}
                · <a class="post-tag" href={`/tags/${tag}`}>{tag}</a>
              </>
            ))}
          </p>
          <div class:list={["post-content", { "drop-cap": hasDropCap(post, rendered) }]}>
            <rendered.Content components={components} />
          </div>
          <Sources {...sources!} citations={rendered.citations} />
          {/* Details for the curious, out of the way at the end. */}
          <footer class="post-meta post-footer">
            {updated! > started! && (
              <>
                Updated <time datetime={updated}>{longDate(post.lastmod)}</time> ·{" "}
              </>
            )}
            <a href={post.sourceUrl}>source</a> ·{" "}
            <a href={history} {...external(history!)}>
              history
            </a>
          </footer>
        </article>
      </Base>
    )
  )
}
