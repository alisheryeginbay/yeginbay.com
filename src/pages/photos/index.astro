---
// Every photo, newest first. Read from the manifest on each request
// (src/lib/photos.ts). A photo opens over the grid (src/scripts/lightbox.ts);
// each also has a page of its own, which the links go to without JavaScript.
import Base from "../../layouts/Base.astro";
import {
  aiTitleNote,
  CACHE_SECONDS,
  fullSrcset,
  getPhotos,
  photoAlt,
  photoTitle,
  placeholder,
  thumbSrcset,
} from "../../lib/photos.ts";

export const prerender = false;

const photos = await getPhotos();
// Three of every fifteen photos take a square of four tiles: on six columns,
// one in the middle of two rows, then one at each side of the next two.
const isBig = (i: number) => [2, 9, 12].includes(i % 15);

Astro.response.headers.set("Cache-Control", `public, max-age=${CACHE_SECONDS}`);
---

<Base title="Photos">
  <h1>Photos</h1>
  <ul class="photo-grid">
    {
      photos.map((photo, i) => (
        <li class:list={{ "photo-big": isBig(i) }}>
          <a
            href={`/photos/${photo.slug}`}
            data-srcset={fullSrcset(photo, [640, 1280, 2048])}
            data-ratio={photo.width / photo.height}
            data-title={photoTitle(photo)}
            data-caption={photo.caption ?? undefined}
            data-ai={aiTitleNote(photo)}
          >
            <img
              srcset={thumbSrcset(photo, [320, 640, 960, 1280])}
              sizes={
                isBig(i)
                  ? "(min-width: 52rem) 33vw, (min-width: 32rem) 48vw, 48vw"
                  : "(min-width: 52rem) 16vw, (min-width: 32rem) 24vw, 48vw"
              }
              width="300"
              height="400"
              alt={photoAlt(photo)}
              loading={i < 8 ? "eager" : "lazy"}
              decoding="async"
              style={`background-image: url(${placeholder(photo)})`}
            />
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Photo">
    <div class="lightbox-stage">
      <img alt="" sizes="100vw" />
    </div>
    <button class="lightbox-close" type="button" aria-label="Close">×</button>
    <button class="lightbox-prev" type="button" aria-label="Newer photo">←</button>
    <button class="lightbox-next" type="button" aria-label="Older photo">→</button>
    <div class="lightbox-info">
      <p class="lightbox-title"></p>
      <p class="lightbox-ai"><a href="/ai-disclosure"></a></p>
      <p class="lightbox-caption"></p>
      <a class="lightbox-page" href="">Open in a separate page</a>
    </div>
  </dialog>
</Base>

<script>
  import "../../scripts/lightbox.ts";
</script>
