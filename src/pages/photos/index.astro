---
// Every photo, newest first. Read from the manifest on each request
// (src/lib/photos.ts).
import Base from "../../layouts/Base.astro";
import { CACHE_SECONDS, getPhotos, photoAlt, placeholder, thumbSrcset, transitionName } from "../../lib/photos.ts";

export const prerender = false;

const photos = await getPhotos();

Astro.response.headers.set("Cache-Control", `public, max-age=${CACHE_SECONDS}`);
---

<Base title="Photos">
  <h1>Photos</h1>
  <ul class="photo-grid">
    {
      photos.map((photo, i) => (
        <li>
          <a href={`/photos/${photo.slug}`}>
            <img
              srcset={thumbSrcset(photo, [320, 640])}
              sizes="(min-width: 52rem) 11rem, (min-width: 32rem) 30vw, 45vw"
              width="320"
              height="320"
              alt={photoAlt(photo)}
              loading={i < 8 ? "eager" : "lazy"}
              decoding="async"
              style={`background-image: url(${placeholder(photo)}); view-transition-name: ${transitionName(photo)}`}
            />
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style is:global>
  /* Animate between the grid and a photo's page in browsers that can. */
  @view-transition { navigation: auto; }
</style>
