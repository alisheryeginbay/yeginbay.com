---
// The reading list declared in the front matter of content/pages/books.mdx,
// under the prose of that page. Books are sorted and grouped here.
import { getEntry, render } from "astro:content";
import BookList from "../components/BookList.astro";
import Heading from "../components/Heading.astro";
import type { Book } from "../content.config.ts";
import Base from "../layouts/Base.astro";
import { isoDate, longDate } from "../lib/dates.ts";
import { lastCommitDate } from "../lib/git.ts";

const page = (await getEntry("pages", "books"))!;
const { Content } = await render(page);
const updated = lastCommitDate("content/pages/books.mdx");

const books = page.data.books ?? [];
// Within a section, the order the books are listed in, except that finished
// books go newest first.
const byFinished = (a: Book, b: Book) => (b.finished?.getTime() ?? 0) - (a.finished?.getTime() ?? 0);
const withStatus = (status: Book["status"]) => books.filter((b) => b.status === status);
const reading = withStatus("reading");
const abandoned = withStatus("abandoned").sort(byFinished);
const toRead = withStatus("to-read");

// Read books by the year they were finished, newest first, then the undated.
const read = withStatus("read").sort(byFinished);
const year = (b: Book) => String(b.finished!.getUTCFullYear());
const dated = read.filter((b) => b.finished);
const years = [...new Set(dated.map(year))];
const undated = read.filter((b) => !b.finished);
---

<Base title={page.data.title}>
  <article class="post">
    <h1>{page.data.title}</h1>
    {updated && <time datetime={isoDate(updated)}>Last updated {longDate(updated)}</time>}
    <div class="post-content">
      <Content />

      {
        reading.length > 0 && (
          <>
            <Heading level={2} text="Reading now" />
            <BookList books={reading} />
          </>
        )
      }

      {
        read.length > 0 && (
          <>
            <Heading level={2} text="Read" />
            {years.map((y) => (
              <>
                <Heading level={3} text={y} />
                <BookList books={dated.filter((b) => year(b) === y)} />
              </>
            ))}
            {undated.length > 0 && (
              <>
                <Heading level={3} text="Undated" />
                <BookList books={undated} />
              </>
            )}
          </>
        )
      }

      {
        abandoned.length > 0 && (
          <>
            <Heading level={2} text="Abandoned" />
            <BookList books={abandoned} />
          </>
        )
      }

      {
        toRead.length > 0 && (
          <details class="book-shelf">
            <summary>
              <Heading level={2} text="Want to read" html={`Want to read <span class="book-count">${toRead.length}</span>`} unlinked />
            </summary>
            <BookList books={toRead} />
          </details>
        )
      }
    </div>
  </article>
</Base>
