---
import "../styles/style.css";
import { SITE } from "../site.ts";

interface Props {
  // The page's title; the home page has none of its own.
  title?: string;
  description?: string;
  authors?: string[];
  noindex?: boolean;
  dropCap?: boolean;
  hasMath?: boolean;
  // Typst's styles for the MathML in a post written in Typst.
  typstCss?: string;
  // Pages with no address of their own, such as the 404, have no canonical.
  canonical?: boolean;
  ogType?: "website" | "article";
  // The page's source in plain text, offered to scrapers and models.
  source?: { href: string; type: string };
  // Structured data (schema.org), written as JSON-LD.
  jsonLd?: object;
}

const {
  title,
  description,
  authors = [SITE.author],
  noindex = false,
  dropCap = false,
  hasMath = false,
  typstCss,
  canonical = true,
  ogType = "website",
  source,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const pageDescription = description || SITE.description;
// Pages are served without a trailing slash (wrangler.toml).
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), SITE.url).href;
// JSON in a <script> can't contain "</script>", so "<" is escaped.
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");

// Source Han Serif KR for Hangul. Built sites use the subsets that
// scripts/subset-korean.ts writes before `astro build`; `astro dev` uses the
// full Hangul fonts, so new text never needs a rerun.
const koreanFonts = import.meta.env.DEV
  ? import.meta.glob<string>("../assets/fonts/sourcehanserifkr-hangul-*.woff2", { query: "?url", import: "default", eager: true })
  : import.meta.glob<string>("../assets/fonts/subset/sourcehanserifkr-*.woff2", { query: "?url", import: "default", eager: true });
const koreanFaces = Object.entries(koreanFonts)
  .map(([file, url]) => {
    const weight = file.match(/-(\d+)\.woff2$/)![1];
    return `@font-face{font-family:"Source Han Serif KR";font-style:normal;font-weight:${weight};font-display:swap;src:url(${JSON.stringify(url)}) format("woff2");unicode-range:U+1100-11FF,U+3130-318F,U+A960-A97F,U+AC00-D7FF}`;
  })
  .join("");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={authors.join(", ")} />
    <meta name="description" content={pageDescription} />
    {canonical && <link rel="canonical" href={pageUrl} />}
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    {canonical && <meta property="og:url" content={pageUrl} />}
    {source && <link rel="alternate" type={source.type} href={source.href} title="Source" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="For language models" />
    {ld && <script type="application/ld+json" is:inline set:html={ld} />}
    <!-- 🐠 as Apple's emoji draws it. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/sourceserif4-400.woff2" as="font" type="font/woff2" crossorigin />
    {dropCap && <link rel="preload" href="/fonts/goudyinitialen.woff2" as="font" type="font/woff2" crossorigin />}
    {koreanFaces && <style is:inline set:html={koreanFaces} />}
    <link rel="alternate" type="application/rss+xml" href="/index.xml" title={SITE.title} />
    {typstCss && <style is:inline set:html={typstCss} />}
    {hasMath && <link rel="stylesheet" href="/vendor/katex/katex.min.css" />}
  </head>
  <body>
    <div class="layout">
      <header class="site-header">
        <a class="site-title" href="/">{SITE.title}</a>
        <nav class="site-nav">
          <a href="/writings">Writings</a>
          <a href="/photos">Photos</a>
          <a href="/music">Music</a>
        </nav>
      </header>
      <aside class="sidebar">
        <slot name="sidebar" />
      </aside>
      <main>
        <slot />
      </main>
    </div>
    <script>
      import "../scripts/heading-copy.ts";
    </script>
  </body>
</html>
